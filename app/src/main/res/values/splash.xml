<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Symphony.SplashScreen.Wraith" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_splash_wraith</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Symphony</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Symphony.SplashScreen.Original" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_original</item>
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Symphony</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
